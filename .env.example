# Single admin account for /admin (server-side only; never prefix with NEXT_PUBLIC_).
ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD=choose-a-long-unique-password
# Signs the login cookie. Generate with: openssl rand -hex 32  (minimum 32 characters)
SESSION_SECRET=
# Vercel Blob read/write token (Vercel dashboard > Storage > Blob; locally: `vercel env pull .env.local`).
BLOB_READ_WRITE_TOKEN=
